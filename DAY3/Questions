package DAY3;

public class Day3
{
    public static void main(String[] args)
    {
        int a[] = {2, 7, 11, 15};

        int left = 0;
        int right = a.length - 1;

        int target = 9;

        while(left < right)
        {
            int sum = a[left] + a[right];

            if(sum < target)
            {
                left++;
            }
            else if(sum > target)
            {
                right--;
            }
            else
            {
                System.out.println("Pair found: "
                        + a[left] + ", " + a[right]);

                System.out.println("Indices: "
                        + left + ", " + right);

                break;
            }
        }
    }
}



